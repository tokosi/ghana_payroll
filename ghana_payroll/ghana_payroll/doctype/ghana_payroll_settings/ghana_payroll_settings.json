 "fields": [
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Enable Ghana PAYE Engine", "default": "1", "description": "When enabled, Salary Slips use Ghana monthly graduated bands instead of the standard ERPNext annualised tax engine."},
  {"fieldname": "cb_head", "fieldtype": "Column Break"},
  {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "default": "GHS"},

  {"fieldname": "sec_ssnit", "fieldtype": "Section Break", "label": "SSNIT Contribution Rates"},
  {"fieldname": "ssnit_employee_rate", "fieldtype": "Percent", "label": "Employee SSNIT Rate (%)", "default": "5.5", "reqd": 1, "description": "Percentage of pensionable basic salary withheld from the employee."},
  {"fieldname": "ssnit_employer_rate", "fieldtype": "Percent", "label": "Employer SSNIT Rate (%)", "default": "13", "reqd": 1, "description": "Employer's share. Statistical: does not reduce net pay."},
  {"fieldname": "ssnit_total_html", "fieldtype": "HTML", "options": "<p class='text-muted small'>Employee 5.5% + Employer 13% = 18.5% total, split as Tier 1 (13.5% to SSNIT) and Tier 2 (5% to an approved private scheme).</p>"},
  {"fieldname": "cb_ssnit", "fieldtype": "Column Break"},
  {"fieldname": "ssnit_tier1_rate", "fieldtype": "Percent", "label": "Tier 1 Rate (%)", "default": "13.5", "description": "Reported to SSNIT."},
  {"fieldname": "ssnit_tier2_rate", "fieldtype": "Percent", "label": "Tier 2 Rate (%)", "default": "5", "description": "Reported to the approved Tier 2 trustee."},

  {"fieldname": "sec_insurable", "fieldtype": "Section Break", "label": "Insurable Earnings Limits", "collapsible": 1},
  {"fieldname": "ssnit_min_insurable_earnings", "fieldtype": "Currency", "label": "Minimum Insurable Earnings (Monthly)", "default": "0", "description": "0 = no floor."},
  {"fieldname": "cb_insurable", "fieldtype": "Column Break"},
  {"fieldname": "ssnit_max_insurable_earnings", "fieldtype": "Currency", "label": "Maximum Insurable Earnings (Monthly)", "default": "69000", "description": "SSNIT ceiling. Contributions are capped at this basic salary. 0 = no ceiling."},

  {"fieldname": "sec_pf", "fieldtype": "Section Break", "label": "Provident Fund (Tier 3) Rates"},
  {"fieldname": "pf_employee_rate", "fieldtype": "Percent", "label": "Employee Provident Fund Rate (%)", "default": "10", "reqd": 1},
  {"fieldname": "cb_pf", "fieldtype": "Column Break"},
  {"fieldname": "pf_employer_rate", "fieldtype": "Percent", "label": "Employer Provident Fund Rate (%)", "default": "5", "reqd": 1},

  {"fieldname": "sec_relief", "fieldtype": "Section Break", "label": "Reliefs & Rounding"},
  {"fieldname": "limit_pension_relief", "fieldtype": "Check", "label": "Cap Pension Relief", "default": "0", "description": "Restrict the SSNIT + Provident Fund amount deductible from chargeable income."},
  {"fieldname": "pension_relief_cap_percent", "fieldtype": "Percent", "label": "Pension Relief Cap (% of Basic)", "default": "21.5", "depends_on": "eval:doc.limit_pension_relief"},
  {"fieldname": "cb_relief", "fieldtype": "Column Break"},
  {"fieldname": "apply_employee_tax_relief", "fieldtype": "Check", "label": "Apply Employee Personal Reliefs", "default": "1", "description": "Uses the Monthly Tax Relief field on the Employee record."},
  {"fieldname": "round_paye", "fieldtype": "Check", "label": "Round PAYE to 2 Decimals", "default": "1"},

  {"fieldname": "sec_components", "fieldtype": "Section Break", "label": "Salary Component Mapping"},
  {"fieldname": "components_html", "fieldtype": "HTML", "options": "<p class='text-muted small'>These components are written automatically on every Salary Slip. Any manual amount or formula on them is overridden.</p>"},
  {"fieldname": "ssnit_employee_component", "fieldtype": "Link", "label": "Employee SSNIT Component", "options": "Salary Component", "reqd": 1},
  {"fieldname": "pf_employee_component", "fieldtype": "Link", "label": "Employee Provident Fund Component", "options": "Salary Component", "reqd": 1},
  {"fieldname": "paye_component", "fieldtype": "Link", "label": "PAYE Component", "options": "Salary Component", "reqd": 1},
  {"fieldname": "cb_components", "fieldtype": "Column Break"},
  {"fieldname": "ssnit_employer_component", "fieldtype": "Link", "label": "Employer SSNIT Component", "options": "Salary Component"},
  {"fieldname": "pf_employer_component", "fieldtype": "Link", "label": "Employer Provident Fund Component", "options": "Salary Component"},

  {"fieldname": "sec_mapping", "fieldtype": "Section Break", "label": "Pensionable & Exempt Earnings"},
  {"fieldname": "pensionable_components", "fieldtype": "Table", "label": "Pensionable Components (Basic)", "options": "Ghana Payroll Component", "description": "Earnings that form the base for SSNIT and Provident Fund. Normally just Basic."},
  {"fieldname": "tax_exempt_components", "fieldtype": "Table", "label": "Tax Exempt Components", "options": "Ghana Payroll Component", "description": "Earnings excluded from chargeable income, e.g. approved reimbursements."},

  {"fieldname": "sec_brackets", "fieldtype": "Section Break", "label": "PAYE Graduated Bands (Monthly)"},
  {"fieldname": "brackets_html", "fieldtype": "HTML", "options": "<p class='text-muted small'>Each row is the <b>width</b> of the band, not a cumulative ceiling. Rows are applied top to bottom. Verify against the current GRA schedule before each tax year.</p>"},
  {"fieldname": "tax_brackets", "fieldtype": "Table", "label": "Tax Brackets", "options": "Ghana Tax Bracket", "reqd": 1},

  {"fieldname": "sec_bonus", "fieldtype": "Section Break", "label": "Bonus Concession", "collapsible": 1},
  {"fieldname": "apply_bonus_tax_rule", "fieldtype": "Check", "label": "Apply Bonus Concessionary Rate", "default": "0", "description": "Tax bonus up to the threshold at a flat final rate; the excess is added to chargeable income."},
  {"fieldname": "bonus_tax_rate", "fieldtype": "Percent", "label": "Bonus Tax Rate (%)", "default": "5", "depends_on": "eval:doc.apply_bonus_tax_rule"},
  {"fieldname": "bonus_threshold_percent", "fieldtype": "Percent", "label": "Bonus Threshold (% of Annual Basic)", "default": "15", "depends_on": "eval:doc.apply_bonus_tax_rule"},
  {"fieldname": "bonus_components", "fieldtype": "Table", "label": "Bonus Components", "options": "Ghana Payroll Component", "depends_on": "eval:doc.apply_bonus_tax_rule"}
 ],
